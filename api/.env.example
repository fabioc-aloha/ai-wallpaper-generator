# Azure Key Vault
# Your Key Vault name (without .vault.azure.net)
KEY_VAULT_NAME=your-keyvault-name

# Azure Storage
# Your storage account name (without .blob.core.windows.net)
STORAGE_ACCOUNT_NAME=your-storage-account
STORAGE_CONTAINER_NAME=wallpapers

# AI Model Configuration (optional override)
# Default: black-forest-labs/flux-pro
# Alternatives: black-forest-labs/flux-1.1-pro, ideogram-ai/ideogram-v2
AI_MODEL=black-forest-labs/flux-pro

# Note: These values are populated automatically by Azure Functions
# when using Managed Identity for authentication.
# For local development, configure in local.settings.json instead.
